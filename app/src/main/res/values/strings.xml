    <string name="service_not_running">El servicio no está en ejecución.</string>
    <string name="accessibility_setup_title">Servicio de accesibilidad (opcional)</string>
    <string name="accessibility_setup_text">Activa el servicio de accesibilidad para que Mega Equalizer mantenga activo el motor global y detecte la aplicación en primer plano. La ecualización global cubre todos los canales de la mezcla, incluido el audio de accesibilidad, cuando el dispositivo lo permite. Solo observa el nombre del paquete: no lee la pantalla ni el texto.</string>
    <string name="open_accessibility_settings">Abrir ajustes de accesibilidad</string>
    <string name="accessibility_optional_note">La ecualización global funciona sin este permiso, pero el servicio ayuda a mantenerla activa y a aplicar perfiles por aplicación.</string>

