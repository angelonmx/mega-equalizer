    <string name="settings_battery_heading">Batería</string>
    <string name="settings_battery_explanation">Algunos fabricantes detienen los servicios en segundo plano. Si la ecualización se detiene, permite que Mega Equalizer se ejecute sin restricciones de batería.</string>
    <string name="open_battery_settings">Abrir ajustes de batería</string>
