    <!-- Settings -->
    <string name="settings_title">Ajustes</string>
    <string name="settings_accessibility_heading">Accesibilidad</string>
    <string name="settings_accessibility_explanation">El servicio de accesibilidad es opcional. Mantiene activo el motor global, que procesa la mezcla completa (incluido el canal de accesibilidad de TalkBack) cuando el dispositivo lo permite, y detecta la aplicación en primer plano para aplicar sus perfiles. No lee el texto ni el contenido de la pantalla, no usa captura de pantalla y no envía información a Internet.</string>
    <string name="settings_notifications_heading">Notificaciones</string>
    <string name="settings_notifications_explanation">La notificación del servicio muestra el preset activo y permite desactivar la ecualización sin abrir la app.</string>
